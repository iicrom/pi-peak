{
	"name": "pi-peak",
	"version": "0.2.0",
	"description": "Peak / off-peak hour awareness for models. Configure per-model peak windows (like DeepSeek's UTC 01:00-04:00, 06:00-10:00) and see them in the pi status bar.",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi-extension",
		"peak-hours",
		"off-peak"
	],
	"license": "MIT",
	"pi": {
		"extensions": [
			"./extensions/peak.ts"
		]
	},
	"files": [
		"extensions",
		"src",
		"README.md"
	],
	"scripts": {
		"test": "node --test src/windows.test.ts",
		"smoke": "node scripts/smoke.ts",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@types/node": "*",
		"typescript": "*"
	}
}
